<!-- Ambient Blobs -->
<div class="blob-bg blob-1"></div>
<div class="blob-bg blob-2"></div>
<div class="blob-bg blob-3"></div>

<style>
    /* Ad soyad uzun olduğu için menüyle sıkışmasın */
    .custom-navbar .brand-mark { font-size: 0.85rem; letter-spacing: -0.02em; flex-shrink: 0; }
    .custom-navbar .brand-name { font-size: 1.15rem; white-space: nowrap; }
    @@media (min-width: 992px) and (max-width: 1299.98px) {
        .custom-navbar .brand-name { font-size: 1rem; }
        .custom-navbar .nav-link { padding: 0.5rem 0.6rem !important; }
    }
</style>

<!-- Sticky Navbar -->
<nav id="mainNavbar" class="navbar navbar-expand-lg fixed-top custom-navbar">
    <div class="container">
        @{
            // İsim veritabanından gelir (Ana Sayfa Giriş > Ad Soyad); logoda ad ve soyadın baş harfleri
            string adSoyad = ViewBag.NameSurname ?? "Portfolyo";
            var tr = new System.Globalization.CultureInfo("tr-TR");
            var parcalar = adSoyad.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            string basHarfler = parcalar.Length > 1
                ? $"{char.ToUpper(parcalar[0][0], tr)}{char.ToUpper(parcalar[^1][0], tr)}"
                : adSoyad.Substring(0, 1).ToUpper(tr);
        }
        <a class="navbar-brand d-flex align-items-center" href="#home" aria-label="@adSoyad - Ana Sayfa">
            <span class="brand-mark">@basHarfler</span>
            <span class="brand-name">@adSoyad<span>.</span></span>
        </a>

        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Menüyü Aç/Kapat">
            <i class="bi bi-list fs-2 text-dark"></i>
        </button>

        <div class="collapse navbar-collapse" id="navbarContent">
            <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1">
                <li class="nav-item">
                    <a class="nav-link active" href="#home">Ana Sayfa</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#about">Hakkımda</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#education">Eğitim Hayatım</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#experience">Deneyimlerim</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#skills">Yeteneklerim</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#projects">Projelerim</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#certificates">Sertifikalarım</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#contact">İletişim</a>
                </li>
            </ul>

            @if (ViewBag.HasCv == true)
            {
                <!-- CV, admin panelindeki Ayarlar ekranından yüklenen PDF'tir -->
                <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                    <a href="/Default/DownloadCv" class="btn-custom-primary" id="btnDownloadCv" download>
                        <i class="bi bi-file-earmark-arrow-down"></i>
                        CV İndir
                    </a>
                </div>
            }
        </div>
    </div>
</nav>
