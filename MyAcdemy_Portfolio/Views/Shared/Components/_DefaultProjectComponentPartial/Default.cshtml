@model List<MyAcdemy_Portfolio.Entities.Project>

@{
    // Filtre butonları için projelerdeki kategorileri tekrarsız al
    var kategoriler = Model
        .Where(x => x.Category != null)
        .Select(x => x.Category)
        .GroupBy(c => c.CategoryID)
        .Select(g => g.First())
        .ToList();
}

<!-- Portfolio Projects Section -->
<section id="projects">
    <div class="container">
        <div class="text-center mb-4 reveal-on-scroll">
            <span class="section-eyebrow">SEÇİLMİŞ ÇALIŞMALAR</span>
            <h2 class="section-title">Projelerim</h2>
            <p class="section-subtitle">Öğrendiklerimi gerçek ürünlere dönüştürdüğüm çalışmalar.</p>
        </div>

        <!-- Kategori Filtre Butonları (veritabanından) -->
        <div class="d-flex justify-content-center flex-wrap gap-2 mb-5 reveal-on-scroll" id="projectFilterGroup">
            <button class="filter-btn active" data-filter="all">Tümü</button>
            @foreach (var kat in kategoriler)
            {
                <button class="filter-btn" data-filter="cat-@kat.CategoryID">@kat.CategoryName</button>
            }
        </div>

        <!-- Proje Kartları -->
        <div class="row g-4" id="projectGrid">
            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6 project-item" data-category="cat-@item.CategoryID">
                    <div class="project-card reveal-on-scroll">

                        <!-- Görsel -->
                        <div class="project-thumb">
                            @if (!string.IsNullOrEmpty(item.ProjectImageUrl))
                            {
                                <img src="@item.ProjectImageUrl"
                                     alt="@item.ProjectName"
                                     class="project-img"
                                     loading="lazy"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                            }
                            <div class="project-img-fallback" style="@(string.IsNullOrEmpty(item.ProjectImageUrl) ? "display:flex;" : "display:none;")">
                                <i class="bi bi-code-slash"></i>
                                <span>@item.ProjectName</span>
                            </div>
                        </div>

                        <!-- İçerik -->
                        <div class="project-body">
                            <span class="project-category-badge">@(item.Category?.CategoryName ?? "Genel")</span>
                            <h3 class="project-title">@item.ProjectName</h3>
                            <p class="project-desc">@item.ProjectDescription</p>

                            <div class="project-footer">
                                @if (!string.IsNullOrEmpty(item.GithubUrl))
                                {
                                    <a href="@item.GithubUrl" target="_blank" rel="noopener" class="project-link-btn">
                                        <i class="bi bi-github"></i> GitHub
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(item.ProjectUrl))
                                {
                                    <a href="@item.ProjectUrl" target="_blank" rel="noopener" class="project-link-btn text-primary ms-auto">
                                        <i class="bi bi-box-arrow-up-right"></i> Canlı Demo
                                    </a>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    </div>
</section>

<style>
    .project-thumb {
        aspect-ratio: 16 / 9;
        width: 100%;
        overflow: hidden;
        border-radius: 12px 12px 0 0;
        background: #f1f3f7;
        position: relative;
    }

    .project-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .4s ease;
    }

    .project-card:hover .project-img {
        transform: scale(1.05);
    }

    .project-img-fallback {
        width: 100%;
        height: 100%;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #6c757d;
        font-weight: 600;
    }

        .project-img-fallback i {
            font-size: 2.5rem;
        }
</style>