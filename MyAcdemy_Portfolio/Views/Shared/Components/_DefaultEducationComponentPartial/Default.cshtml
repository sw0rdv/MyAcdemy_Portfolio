@model List<MyAcdemy_Portfolio.Entities.Education>
@{
    var colors = new[] { "bg-icon-purple", "bg-icon-mint", "bg-icon-blue", "bg-icon-peach" };
}

<!-- Education Section -->
<section id="education" style="background-color: var(--bg-secondary);">
    <div class="container">
        <div class="text-center mb-5 reveal-on-scroll">
            <span class="section-eyebrow">AKADEMİK YOLCULUĞUM</span>
            <h2 class="section-title">Eğitim Hayatım</h2>
            <p class="section-subtitle">Yazılım dünyasına uzanan yolculuğumun akademik temelleri.</p>
        </div>

        <div class="timeline-container">
            @for (var i = 0; i < Model.Count; i++)
            {
                var item = Model[i];
                var card = $@"<div class=""timeline-content-card"">
                    <span class=""badge-year {colors[i % colors.Length]} mb-2""><i class=""bi bi-calendar3""></i> {System.Net.WebUtility.HtmlEncode(item.Duration)}</span>
                    <h4 class=""fs-5 fw-bold mb-1"">{System.Net.WebUtility.HtmlEncode(item.Title)}</h4>
                    <div class=""text-primary fw-semibold small mb-2"">{System.Net.WebUtility.HtmlEncode(item.SubTitle)}</div>
                    <p class=""text-secondary small mb-0"">{System.Net.WebUtility.HtmlEncode(item.Description)}</p>
                </div>";

                <div class="timeline-item row align-items-center g-4 reveal-on-scroll">
                    @if (i % 2 == 0)
                    {
                        <div class="col-lg-6 timeline-left order-2 order-lg-1">@Html.Raw(card)</div>
                        <div class="timeline-marker"><i class="bi bi-mortarboard"></i></div>
                        <div class="col-lg-6 timeline-right order-1 order-lg-2 d-none d-lg-block"></div>
                    }
                    else
                    {
                        <div class="col-lg-6 timeline-left d-none d-lg-block"></div>
                        <div class="timeline-marker"><i class="bi bi-book"></i></div>
                        <div class="col-lg-6 timeline-right">@Html.Raw(card)</div>
                    }
                </div>
            }
        </div>
    </div>
</section>
