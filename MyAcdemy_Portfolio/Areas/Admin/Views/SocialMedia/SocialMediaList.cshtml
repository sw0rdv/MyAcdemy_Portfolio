@model List<MyAcdemy_Portfolio.Entities.SocialMedia>
@{
    ViewData["Title"] = "Sosyal Medya";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="list-card">
    <div class="list-card-header">
        <div class="form-card-icon"><i class="bi bi-share"></i></div>
        <div>
            <h5>Sosyal Medya Hesapları</h5>
            <small class="text-secondary">Ana sayfanın giriş bölümünde, İletişim bölümünde ve footer'da sıra numarasına göre görünür.</small>
        </div>
        <div class="ms-auto">
            <a href="/Admin/SocialMedia/CreateSocialMedia" class="btn btn-accent"><i class="bi bi-plus-lg me-1"></i> Yeni Hesap</a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state"><i class="bi bi-share"></i>Henüz sosyal medya hesabı eklenmedi.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Sıra</th>
                        <th>Platform</th>
                        <th class="hide-sm">Adres</th>
                        <th>Durum</th>
                        <th style="text-align:right;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-secondary">@item.DisplayOrder</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="form-card-icon" style="width:36px;height:36px;font-size:1rem;"><i class="bi @item.IconClass"></i></span>
                                    <span class="fw-semibold">@item.PlatformName</span>
                                </div>
                            </td>
                            <td class="hide-sm">
                                <a href="@item.Url" target="_blank" rel="noopener" class="text-decoration-none d-inline-block text-truncate" style="max-width:320px;">@item.Url</a>
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge-status on">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge-status off">Pasif</span>
                                }
                            </td>
                            <td>
                                <div class="row-actions">
                                    <a href="/Admin/SocialMedia/ToggleStatus/@item.SocialMediaID" class="icon-btn toggle" title="@(item.IsActive ? "Gizle" : "Göster")">
                                        <i class="bi @(item.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                    </a>
                                    <a href="/Admin/SocialMedia/UpdateSocialMedia/@item.SocialMediaID" class="icon-btn edit" title="Düzenle"><i class="bi bi-pencil"></i></a>
                                    <a href="/Admin/SocialMedia/DeleteSocialMedia/@item.SocialMediaID" class="icon-btn del js-delete" data-name="@item.PlatformName" title="Sil"><i class="bi bi-trash3"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
