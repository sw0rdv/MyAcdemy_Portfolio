@model MyAcdemy_Portfolio.Areas.Admin.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    // Tüm sayılar DashboardController'da EF Core sorgularıyla hesaplanıp ViewModel ile gelir
    int toplam = Model.TotalMessageCount;
    int okunan = Model.ReadMessageCount;
    int okunmayan = Model.UnreadMessageCount;
    int okunmaOrani = toplam > 0 ? (int)Math.Round(okunan * 100.0 / toplam) : 0;
    string adSoyad = Model.AdminName;

    // Halka grafiği için (SVG çember çevresi: 2πr, r = 52)
    double cevre = 2 * Math.PI * 52;
    string doluKisim = (cevre * okunmaOrani / 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    string cevreStr = cevre.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    var tr = new System.Globalization.CultureInfo("tr-TR");
    int saat = DateTime.Now.Hour;
    string selam = saat < 12 ? "Günaydın" : saat < 18 ? "İyi günler" : "İyi akşamlar";

    string[] tonlar = { "tone-purple", "tone-mint", "tone-peach", "tone-blue" };
    int maxKategori = Model.CategorySummary.Any() ? Model.CategorySummary.Max(x => x.ProjectCount) : 0;

    string BasHarf(string ad) => string.IsNullOrWhiteSpace(ad) ? "?" :
        string.Concat(ad.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpper(x[0], tr)));
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .dash {
        --bg: #F6F7FC;
        --card: #FFFFFF;
        --text: #26334A;
        --muted: #78849A;
        --border: #E7EAF2;
        --purple: #8276D9;
        --purple-dark: #6A5DCB;
        --lavender: #EEEAFD;
        --blue: #E3EEFB;
        --mint: #E1F5EB;
        --peach: #FFEEE2;
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        color: var(--text);
        background: var(--bg);
        padding: 28px;
        border-radius: 24px;
    }

        .dash * {
            box-sizing: border-box;
        }

    /* ---------- Karşılama bandı ---------- */
    .dash-hero {
        position: relative;
        overflow: hidden;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
        padding: 30px 34px;
        border-radius: 22px;
        background: linear-gradient(120deg, #EEEAFD 0%, #E3EEFB 55%, #E1F5EB 100%);
        border: 1px solid var(--border);
        margin-bottom: 24px;
    }

        .dash-hero::before,
        .dash-hero::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
        }

        .dash-hero::before {
            width: 220px;
            height: 220px;
            right: -60px;
            top: -90px;
            background: rgba(130, 118, 217, .18);
        }

        .dash-hero::after {
            width: 140px;
            height: 140px;
            right: 160px;
            bottom: -80px;
            background: rgba(255, 255, 255, .6);
        }

    .dash-eyebrow {
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .14em;
        color: var(--purple-dark);
        text-transform: uppercase;
    }

    .dash-hero h1 {
        font-size: 1.75rem;
        font-weight: 800;
        margin: 6px 0 6px;
        letter-spacing: -.01em;
    }

        .dash-hero h1 span {
            background: linear-gradient(90deg, #8276D9, #5B8DEF);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

    .dash-hero p {
        margin: 0;
        color: var(--muted);
        font-size: .95rem;
    }

    .dash-hero-side {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 999px;
        background: rgba(255, 255, 255, .85);
        border: 1px solid var(--border);
        font-size: .85rem;
        font-weight: 600;
        color: var(--text);
        text-decoration: none;
        backdrop-filter: blur(6px);
    }

    .pill-primary {
        background: var(--purple);
        border-color: var(--purple);
        color: #fff;
        box-shadow: 0 8px 20px rgba(130, 118, 217, .35);
        transition: transform .2s, box-shadow .2s;
    }

        .pill-primary:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 12px 24px rgba(130, 118, 217, .4);
        }

    /* ---------- Ortak kart ---------- */
    .dcard {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 22px;
        box-shadow: 0 4px 18px rgba(38, 51, 74, .04);
    }

    .dcard-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

        .dcard-head h3 {
            font-size: 1rem;
            font-weight: 700;
            margin: 0;
        }

        .dcard-head a {
            font-size: .8rem;
            font-weight: 600;
            color: var(--purple-dark);
            text-decoration: none;
        }

            .dcard-head a:hover {
                text-decoration: underline;
            }

    /* ---------- İstatistik kartları ---------- */
    .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 24px;
    }

    .stat {
        position: relative;
        overflow: hidden;
        transition: transform .2s, box-shadow .2s;
    }

        .stat:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 26px rgba(38, 51, 74, .08);
        }

    .stat-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .stat-icon {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        font-size: 1.25rem;
    }

    .stat-label {
        font-size: .82rem;
        color: var(--muted);
        font-weight: 500;
        margin-top: 16px;
    }

    .stat-value {
        font-size: 2rem;
        font-weight: 800;
        line-height: 1.1;
        margin-top: 2px;
        letter-spacing: -.02em;
    }

    .stat-foot {
        margin-top: 12px;
        font-size: .78rem;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .tone-purple {
        background: var(--lavender);
        color: var(--purple-dark);
    }

    .tone-mint {
        background: var(--mint);
        color: #2E9B6A;
    }

    .tone-peach {
        background: var(--peach);
        color: #D97A3A;
    }

    .tone-blue {
        background: var(--blue);
        color: #3F7BD8;
    }

    .stat-chip {
        font-size: .72rem;
        font-weight: 700;
        padding: 4px 9px;
        border-radius: 999px;
    }

    /* ---------- Ana ızgara ---------- */
    .grid-main {
        display: grid;
        grid-template-columns: 1.9fr 1fr;
        gap: 18px;
        margin-bottom: 24px;
    }

    .grid-bottom {
        display: grid;
        grid-template-columns: 1fr 1.2fr 1fr;
        gap: 18px;
    }

    /* ---------- Mesaj tablosu ---------- */
    .msg-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-size: .88rem;
    }

        .msg-table th {
            text-align: left;
            font-size: .7rem;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: var(--muted);
            font-weight: 700;
            padding: 0 12px 12px;
        }

        .msg-table td {
            padding: 13px 12px;
            border-top: 1px solid #F1F3F8;
            vertical-align: middle;
        }

        .msg-table tbody tr {
            transition: background .15s;
        }

            .msg-table tbody tr:hover {
                background: #FAFAFF;
            }

    .sender {
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .sender strong {
            display: block;
            font-weight: 600;
            font-size: .88rem;
        }

        .sender small {
            color: var(--muted);
            font-size: .75rem;
        }

    .avatar {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        font-weight: 700;
        font-size: .78rem;
        flex-shrink: 0;
    }

    .muted {
        color: var(--muted);
        font-size: .8rem;
    }

    .status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 11px;
        border-radius: 999px;
        font-size: .74rem;
        font-weight: 700;
    }

        .status::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

    .status-new {
        background: var(--peach);
        color: #D97A3A;
    }

    .status-read {
        background: var(--mint);
        color: #2E9B6A;
    }

    /* ---------- Okunma halkası ---------- */
    .ring-wrap {
        position: relative;
        width: 170px;
        height: 170px;
        margin: 4px auto 20px;
    }

        .ring-wrap svg {
            width: 100%;
            height: 100%;
            transform: rotate(-90deg);
        }

    .ring-track {
        stroke: var(--lavender);
    }

    .ring-fill {
        stroke: url(#ringGrad);
        stroke-linecap: round;
        transition: stroke-dasharray .8s ease;
    }

    .ring-center {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        text-align: center;
    }

        .ring-center strong {
            display: block;
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: -.02em;
        }

        .ring-center span {
            font-size: .78rem;
            color: var(--muted);
        }

    .ring-legend {
        display: grid;
        gap: 10px;
    }

        .ring-legend div {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 14px;
            border-radius: 12px;
            background: #F8F9FD;
            font-size: .85rem;
        }

        .ring-legend b {
            font-weight: 700;
        }

    .dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 8px;
    }

    /* ---------- Hızlı işlemler ---------- */
    .quick-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .quick {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 16px;
        border-radius: 16px;
        border: 1px solid var(--border);
        text-decoration: none;
        color: var(--text);
        font-size: .85rem;
        font-weight: 600;
        transition: transform .2s, border-color .2s, box-shadow .2s;
    }

        .quick .stat-icon {
            width: 38px;
            height: 38px;
            font-size: 1.05rem;
            border-radius: 11px;
        }

        .quick:hover {
            color: var(--text);
            transform: translateY(-2px);
            border-color: #D9D3F7;
            box-shadow: 0 8px 18px rgba(130, 118, 217, .12);
        }

    /* ---------- Aktivite zaman çizelgesi ---------- */
    .timeline {
        list-style: none;
        margin: 0;
        padding: 0;
        position: relative;
    }

        .timeline::before {
            content: "";
            position: absolute;
            left: 17px;
            top: 6px;
            bottom: 6px;
            width: 2px;
            background: linear-gradient(var(--lavender), var(--blue));
        }

        .timeline li {
            position: relative;
            display: flex;
            gap: 14px;
            padding: 0 0 18px;
        }

            .timeline li:last-child {
                padding-bottom: 0;
            }

        .timeline .t-icon {
            position: relative;
            z-index: 1;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            font-size: .9rem;
            border: 3px solid #fff;
            flex-shrink: 0;
        }

        .timeline strong {
            display: block;
            font-size: .87rem;
            font-weight: 600;
            margin-top: 2px;
        }

    /* ---------- Yetenek etiketleri ---------- */
    .skill-group + .skill-group {
        margin-top: 16px;
    }

    .skill-group h4 {
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--muted);
        font-weight: 700;
        margin: 0 0 10px;
    }

    .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .chip {
        padding: 7px 12px;
        border-radius: 10px;
        font-size: .8rem;
        font-weight: 600;
        border: 1px solid transparent;
        transition: transform .15s;
    }

        .chip:hover {
            transform: translateY(-1px);
        }

    /* ---------- Responsive ---------- */
    @@media (max-width: 1200px) {
        .stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .grid-bottom {
            grid-template-columns: 1fr 1fr;
        }

            .grid-bottom > :last-child {
                grid-column: 1 / -1;
            }
    }

    @@media (max-width: 992px) {
        .grid-main {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 640px) {
        .dash {
            padding: 16px;
        }

        .stats, .grid-bottom {
            grid-template-columns: 1fr;
        }

        .dash-hero {
            padding: 24px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .dash * {
            transition: none !important;
        }
    }
</style>

<style>
    .stats { grid-template-columns: repeat(4, 1fr); }
    .msg-table tbody tr.clickable { cursor: pointer; }
    .proj-item { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid #F1F3F8; text-decoration: none; color: inherit; }
    .proj-item:last-child { border-bottom: none; }
    .proj-item:hover strong { color: var(--purple-dark); }
    .proj-thumb { width: 48px; height: 48px; border-radius: 12px; object-fit: cover; flex-shrink: 0; display: grid; place-items: center; }
    .proj-item small { color: var(--muted); font-size: .76rem; }
    .cat-row { margin-bottom: 14px; }
    .cat-row:last-child { margin-bottom: 0; }
    .cat-row-head { display: flex; justify-content: space-between; font-size: .82rem; margin-bottom: 6px; }
    .cat-bar { height: 10px; background: #EEF0F6; border-radius: 99px; overflow: hidden; }
    .cat-bar span { display: block; height: 100%; border-radius: 99px; background: linear-gradient(90deg, #A99FEA, #6A5DCB); }
    .badge-on, .badge-off { font-size: .7rem; font-weight: 700; padding: 3px 9px; border-radius: 999px; }
    .badge-on { background: var(--mint); color: #2E9B6A; }
    .badge-off { background: #F1F2F6; color: #8C96A8; }
    .dash-empty { color: var(--muted); font-size: .85rem; text-align: center; padding: 24px 0; }
</style>

<div class="dash">

    <!-- Karşılama -->
    <section class="dash-hero">
        <div style="position:relative; z-index:1;">
            <div class="dash-eyebrow">Yönetim Paneli</div>
            <h1>@selam, <span>@adSoyad</span> 👋</h1>
            <p>Portfolyo sitenin genel durumu ve son hareketler burada.</p>
        </div>
        <div class="dash-hero-side">
            <span class="pill"><i class="bi bi-calendar3"></i> @DateTime.Now.ToString("dd MMMM yyyy, dddd", tr)</span>
            <a href="/" target="_blank" class="pill pill-primary"><i class="bi bi-box-arrow-up-right"></i> Siteyi Görüntüle</a>
        </div>
    </section>

    <!-- İstatistikler -->
    <section class="stats">
        <a href="/Admin/Project/ProjectList" class="dcard stat text-decoration-none" style="color:inherit;">
            <div class="stat-top">
                <div class="stat-icon tone-blue"><i class="bi bi-folder2-open"></i></div>
                <span class="stat-chip tone-blue">Tümü</span>
            </div>
            <div class="stat-label">Toplam Proje</div>
            <div class="stat-value">@Model.TotalProjectCount</div>
            <div class="stat-foot"><i class="bi bi-grid"></i> Kayıtlı tüm projeler</div>
        </a>

        <a href="/Admin/Project/ProjectList" class="dcard stat text-decoration-none" style="color:inherit;">
            <div class="stat-top">
                <div class="stat-icon tone-mint"><i class="bi bi-broadcast"></i></div>
                <span class="stat-chip tone-mint">Yayında</span>
            </div>
            <div class="stat-label">Aktif Proje</div>
            <div class="stat-value">@Model.ActiveProjectCount</div>
            <div class="stat-foot"><i class="bi bi-eye"></i> Sitede görünen projeler</div>
        </a>

        <a href="/Admin/Skill/SkillList" class="dcard stat text-decoration-none" style="color:inherit;">
            <div class="stat-top">
                <div class="stat-icon tone-purple"><i class="bi bi-code-slash"></i></div>
            </div>
            <div class="stat-label">Yetenek</div>
            <div class="stat-value">@Model.SkillCount</div>
            <div class="stat-foot"><i class="bi bi-bar-chart"></i> Seviye bilgisiyle</div>
        </a>

        <a href="/Admin/Experience/ExperienceList" class="dcard stat text-decoration-none" style="color:inherit;">
            <div class="stat-top">
                <div class="stat-icon tone-peach"><i class="bi bi-briefcase"></i></div>
            </div>
            <div class="stat-label">Deneyim</div>
            <div class="stat-value">@Model.ExperienceCount</div>
            <div class="stat-foot"><i class="bi bi-building"></i> İş ve staj kayıtları</div>
        </a>

        <a href="/Admin/Education/EducationList" class="dcard stat text-decoration-none" style="color:inherit;">
            <div class="stat-top">
                <div class="stat-icon tone-blue"><i class="bi bi-mortarboard"></i></div>
            </div>
            <div class="stat-label">Eğitim</div>
            <div class="stat-value">@Model.EducationCount</div>
            <div class="stat-foot"><i class="bi bi-book"></i> Okul kayıtları</div>
        </a>

        <a href="/Admin/Message/MessageList" class="dcard stat text-decoration-none" style="color:inherit;">
            <div class="stat-top">
                <div class="stat-icon tone-purple"><i class="bi bi-envelope"></i></div>
                <span class="stat-chip tone-purple">%@(okunmaOrani) okundu</span>
            </div>
            <div class="stat-label">Toplam Mesaj</div>
            <div class="stat-value">@toplam</div>
            <div class="stat-foot"><i class="bi bi-inbox"></i> Gelen kutusundaki tüm mesajlar</div>
        </a>

        <a href="/Admin/Message/MessageList?status=unread" class="dcard stat text-decoration-none" style="color:inherit;">
            <div class="stat-top">
                <div class="stat-icon tone-peach"><i class="bi bi-envelope-exclamation"></i></div>
                @if (okunmayan > 0)
                {
                    <span class="stat-chip tone-peach">Bekliyor</span>
                }
            </div>
            <div class="stat-label">Okunmamış Mesaj</div>
            <div class="stat-value">@okunmayan</div>
            <div class="stat-foot"><i class="bi bi-clock-history"></i> Yanıt bekleyenler</div>
        </a>

        <a href="/Admin/Category/CategoryList" class="dcard stat text-decoration-none" style="color:inherit;">
            <div class="stat-top">
                <div class="stat-icon tone-mint"><i class="bi bi-tags"></i></div>
            </div>
            <div class="stat-label">Kategori</div>
            <div class="stat-value">@Model.CategorySummary.Count</div>
            <div class="stat-foot"><i class="bi bi-diagram-2"></i> Proje kategorileri</div>
        </a>
    </section>

    <!-- Son 5 mesaj + Okunma oranı -->
    <section class="grid-main">
        <div class="dcard">
            <div class="dcard-head">
                <h3>Son 5 Mesaj</h3>
                <a href="/Admin/Message/MessageList">Tümünü gör <i class="bi bi-arrow-right"></i></a>
            </div>
            @if (!Model.LastMessages.Any())
            {
                <div class="dash-empty"><i class="bi bi-inbox d-block fs-3 mb-1"></i>Henüz mesaj yok.</div>
            }
            else
            {
                <div style="overflow-x:auto;">
                    <table class="msg-table">
                        <thead>
                            <tr>
                                <th>Gönderen</th>
                                <th>Konu</th>
                                <th>Tarih</th>
                                <th>Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.LastMessages.Count; i++)
                            {
                                var item = Model.LastMessages[i];
                                <tr class="clickable" onclick="location.href='/Admin/Message/MessageList?open=@item.MessageID'" title="Mesajı aç">
                                    <td>
                                        <div class="sender">
                                            <span class="avatar @tonlar[i % tonlar.Length]">@BasHarf(item.NameSurname)</span>
                                            <div><strong>@item.NameSurname</strong><small>@item.Email</small></div>
                                        </div>
                                    </td>
                                    <td>@item.Subject</td>
                                    <td class="muted">@item.SendDate.ToString("dd MMM yyyy", tr)</td>
                                    <td>
                                        @if (item.IsRead)
                                        {
                                            <span class="status status-read">Okundu</span>
                                        }
                                        else
                                        {
                                            <span class="status status-new">Okunmadı</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="dcard">
            <div class="dcard-head">
                <h3>Mesaj Okunma Oranı</h3>
            </div>
            <div class="ring-wrap">
                <svg viewBox="0 0 120 120" aria-hidden="true">
                    <defs>
                        <linearGradient id="ringGrad" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0" stop-color="#A99FEA" />
                            <stop offset="1" stop-color="#6A5DCB" />
                        </linearGradient>
                    </defs>
                    <circle class="ring-track" cx="60" cy="60" r="52" fill="none" stroke-width="12" />
                    <circle class="ring-fill" cx="60" cy="60" r="52" fill="none" stroke-width="12"
                            stroke-dasharray="@(doluKisim) @(cevreStr)" />
                </svg>
                <div class="ring-center">
                    <div><strong>%@(okunmaOrani)</strong><span>okundu</span></div>
                </div>
            </div>
            <div class="ring-legend">
                <div><span><span class="dot" style="background:#7C6FD6;"></span>Okunan</span><b>@okunan</b></div>
                <div><span><span class="dot" style="background:#D9D3F7;"></span>Okunmayan</span><b>@okunmayan</b></div>
            </div>
        </div>
    </section>

    <!-- Alt bölüm: Son 3 proje / Kategori özeti / Hızlı işlemler -->
    <section class="grid-bottom">
        <div class="dcard">
            <div class="dcard-head">
                <h3>Son 3 Proje</h3>
                <a href="/Admin/Project/ProjectList">Tümü <i class="bi bi-arrow-right"></i></a>
            </div>
            @if (!Model.LastProjects.Any())
            {
                <div class="dash-empty">Henüz proje yok.</div>
            }
            @foreach (var p in Model.LastProjects)
            {
                <a href="/Admin/Project/UpdateProject/@p.ProjectID" class="proj-item" title="Düzenle">
                    @if (!string.IsNullOrEmpty(p.ProjectImageUrl))
                    {
                        <img src="@p.ProjectImageUrl" alt="@p.ProjectName" class="proj-thumb" />
                    }
                    else
                    {
                        <span class="proj-thumb tone-blue"><i class="bi bi-folder2"></i></span>
                    }
                    <div class="flex-grow-1 overflow-hidden">
                        <strong class="d-block text-truncate">@p.ProjectName</strong>
                        <small>@(p.Category?.CategoryName ?? "-")</small>
                    </div>
                    <span class="@(p.IsActive ? "badge-on" : "badge-off")">@(p.IsActive ? "Aktif" : "Pasif")</span>
                    <i class="bi bi-pencil-square text-secondary"></i>
                </a>
            }
        </div>

        <div class="dcard">
            <div class="dcard-head">
                <h3>Kategori Özeti</h3>
                <a href="/Admin/Category/CategoryList">Yönet <i class="bi bi-arrow-right"></i></a>
            </div>
            @if (!Model.CategorySummary.Any())
            {
                <div class="dash-empty">Henüz kategori yok.</div>
            }
            @foreach (var c in Model.CategorySummary)
            {
                var yuzde = maxKategori > 0 ? c.ProjectCount * 100 / maxKategori : 0;
                <div class="cat-row">
                    <div class="cat-row-head"><span>@c.CategoryName</span><b>@c.ProjectCount proje</b></div>
                    <div class="cat-bar"><span style="width:@(yuzde)%"></span></div>
                </div>
            }
        </div>

        <div class="dcard">
            <div class="dcard-head"><h3>Hızlı İşlemler</h3></div>
            <div class="quick-grid">
                <a href="/Admin/Project/CreateProject" class="quick"><span class="stat-icon tone-purple"><i class="bi bi-plus-lg"></i></span>Yeni Proje Ekle</a>
                <a href="/Admin/Message/MessageList" class="quick"><span class="stat-icon tone-mint"><i class="bi bi-chat-dots"></i></span>Mesajları Görüntüle</a>
                <a href="/" target="_blank" class="quick"><span class="stat-icon tone-blue"><i class="bi bi-box-arrow-up-right"></i></span>Portfolyoyu Aç</a>
                <a href="/Admin/Setting/UpdateSetting" class="quick"><span class="stat-icon tone-peach"><i class="bi bi-file-earmark-pdf"></i></span>CV Güncelle</a>
            </div>
        </div>
    </section>

</div>
