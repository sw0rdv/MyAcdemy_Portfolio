@model MyAcdemy_Portfolio.Entities.Education

<div class="form-card">
    <form asp-area="Admin" asp-controller="Education" asp-action="@ViewData["FormAction"]" method="post">
        <input type="hidden" asp-for="EducationID" />

        <div class="form-card-header">
            <div class="form-card-icon"><i class="bi bi-mortarboard"></i></div>
            <div>
                <h5 class="mb-0 fw-bold">@ViewData["FormTitle"]</h5>
                <small class="text-secondary">Kayıtlar başlangıç yılına göre sıralanır.</small>
            </div>
        </div>

        <div class="form-card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="Title" class="form-label">Okul <span class="req">*</span></label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-building"></i>
                        <input asp-for="Title" class="form-control" placeholder="Örn: İstanbul Aydın Üniversitesi" />
                    </div>
                    <span asp-validation-for="Title"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="SubTitle" class="form-label">Bölüm</label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-journal-text"></i>
                        <input asp-for="SubTitle" class="form-control" placeholder="Örn: Yazılım Mühendisliği" />
                    </div>
                    <span asp-validation-for="SubTitle"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Duration" class="form-label">Tarih Aralığı (sitede görünen) <span class="req">*</span></label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-calendar3"></i>
                        <input asp-for="Duration" class="form-control" placeholder="Örn: 2021 – 2025" />
                    </div>
                    <span asp-validation-for="Duration"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="StartYear" class="form-label">Başlangıç Yılı (sıralama için) <span class="req">*</span></label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-sort-numeric-down"></i>
                        <input asp-for="StartYear" type="number" min="1950" max="2100" class="form-control" />
                    </div>
                    <span asp-validation-for="StartYear"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label">Açıklama <span class="req">*</span></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Durum</label>
                    <div class="status-box">
                        <div>
                            <div class="fw-semibold" style="font-size: 0.86rem;">Sitede göster</div>
                            <small class="text-secondary">Pasif kayıtlar portfolyoda görünmez.</small>
                        </div>
                        <div class="form-check form-switch m-0">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-card-footer">
            <a href="/Admin/Education/EducationList" class="btn btn-soft"><i class="bi bi-arrow-left me-1"></i> Vazgeç</a>
            <button type="submit" class="btn btn-accent"><i class="bi bi-check2-circle me-1"></i> Kaydet</button>
        </div>
    </form>
</div>
