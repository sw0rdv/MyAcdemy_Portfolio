@model List<MyAcdemy_Portfolio.Entities.Education>
@{
    ViewData["Title"] = "Eğitim";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="list-card">
    <div class="list-card-header">
        <div class="form-card-icon"><i class="bi bi-mortarboard"></i></div>
        <div>
            <h5>Eğitim Bilgileri</h5>
            <small class="text-secondary">Başlangıç yılına göre yeniden eskiye sıralı. Pasif kayıtlar sitede görünmez.</small>
        </div>
        <div class="ms-auto">
            <a href="/Admin/Education/CreateEducation" class="btn btn-accent"><i class="bi bi-plus-lg me-1"></i> Yeni Eğitim</a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state"><i class="bi bi-mortarboard"></i>Henüz eğitim bilgisi eklenmedi.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Okul</th>
                        <th class="hide-sm">Bölüm</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th style="text-align:right;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Title</td>
                            <td class="hide-sm">@item.SubTitle</td>
                            <td class="text-nowrap">@item.Duration</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge-status on">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge-status off">Pasif</span>
                                }
                            </td>
                            <td>
                                <div class="row-actions">
                                    <a href="/Admin/Education/ToggleStatus/@item.EducationID" class="icon-btn toggle" title="@(item.IsActive ? "Pasife al" : "Aktif et")">
                                        <i class="bi @(item.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                    </a>
                                    <a href="/Admin/Education/UpdateEducation/@item.EducationID" class="icon-btn edit" title="Düzenle"><i class="bi bi-pencil"></i></a>
                                    <a href="/Admin/Education/DeleteEducation/@item.EducationID" class="icon-btn del js-delete" data-name="@item.Title" title="Sil"><i class="bi bi-trash3"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
