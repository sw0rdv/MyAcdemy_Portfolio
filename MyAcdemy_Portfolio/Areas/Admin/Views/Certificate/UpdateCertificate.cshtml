@model MyAcdemy_Portfolio.Entities.Certificate

@{
    ViewData["Title"] = "Sertifika Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container">
    <br />
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Sertifika Güncelle</h4>
        <a href="/Admin/Certificate/CertificateList" class="btn btn-outline-secondary">Listeye Dön</a>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-area="Admin" asp-controller="Certificate" asp-action="UpdateCertificate" method="post">
                <input type="hidden" asp-for="CertificateID" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Sertifika Adı</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Issuer" class="form-label">Veren Kurum</label>
                    <input asp-for="Issuer" class="form-control" />
                    <span asp-validation-for="Issuer" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Year" class="form-label">Yıl</label>
                    <input asp-for="Year" class="form-control" />
                    <span asp-validation-for="Year" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CertificateUrl" class="form-label">Sertifika Bağlantısı (opsiyonel)</label>
                    <input asp-for="CertificateUrl" type="url" class="form-control" placeholder="https://..." />
                    <span asp-validation-for="CertificateUrl" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Güncelle</button>
                <a href="/Admin/Certificate/CertificateList" class="btn btn-light">İptal</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
