@{
    // Aktif menüyü o anki controller'a göre işaretle
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<aside id="sidebar-wrapper" aria-label="Ana Yönetim Gezintisi">
    <!-- Brand Header -->
    <div class="sidebar-brand d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
            <div class="brand-mark">P</div>
            <div>
                <div class="fw-bold text-white fs-6 lh-1" style="font-family: 'Plus Jakarta Sans';">Özgür</div>
                <small class="text-white-50" style="font-size: 0.72rem; letter-spacing: 0.02em;">Portfolio Admin</small>
            </div>
        </div>
        <span class="badge" style="background: rgba(220, 226, 245, 0.15); color: #DCE2F5; font-size: 0.65rem; border-radius: 6px;">v1.0</span>
    </div>

    <!-- Admin Identity Bar -->
    <div class="sidebar-user-card">
        <div class="sidebar-user-avatar">PA</div>
        <div class="overflow-hidden">
            <div class="fw-semibold text-white text-truncate" style="font-size: 0.83rem;">Özgür Nuri VURAL</div>
            <div class="d-flex align-items-center gap-1">
                <span style="width: 6px; height: 6px; border-radius: 50%; background-color: #55E197;"></span>
                <span style="font-size: 0.7rem; color: #B3BFDF;">Yönetici</span>
            </div>
        </div>
    </div>

    <!-- Scrollable Nav Groups -->
    <div class="sidebar-nav-scroll">
        <!-- GENEL -->
        <div class="nav-group-title">Genel</div>
        <a href="/Admin/Dashboard/Index" class="sidebar-link @Active("Dashboard")">
            <i class="bi bi-speedometer2"></i>
            <span>Dashboard</span>
        </a>
        <a href="javascript:void(0)" onclick="openPublicPortfolio()" class="sidebar-link">
            <i class="bi bi-box-arrow-up-right"></i>
            <span>Portfolyoyu Görüntüle</span>
        </a>

        <!-- İÇERİK YÖNETİMİ -->
        <div class="nav-group-title">İçerik Yönetimi</div>
        <a href="/Admin/HeroSection/UpdateHeroSection" class="sidebar-link @Active("HeroSection")">
            <i class="bi bi-house-door"></i>
            <span>Ana Sayfa Giriş</span>
        </a>
        <a href="/Admin/About/UpdateAbout" class="sidebar-link @Active("About")">
            <i class="bi bi-person"></i>
            <span>Hakkımda</span>
        </a>
        <a href="/Admin/Education/EducationList" class="sidebar-link @Active("Education")">
            <i class="bi bi-mortarboard"></i>
            <span>Eğitim Hayatım</span>
        </a>
        <a href="/Admin/Experience/ExperienceList" class="sidebar-link @Active("Experience")">
            <i class="bi bi-briefcase-fill"></i>
            <span>Deneyimlerim</span>
        </a>
        <a href="#" class="sidebar-link placeholder-link" data-module="Yeteneklerim">
            <i class="bi bi-code-slash"></i>
            <span>Yeteneklerim</span>
        </a>
        <a href="/Admin/Project/ProjectList" class="sidebar-link @Active("Project")">
            <i class="bi bi-grid-fill"></i>
            <span>Projelerim</span>
        </a>
        <a href="/Admin/Certificate/CertificateList" class="sidebar-link @Active("Certificate")">
            <i class="bi bi-award"></i>
            <span>Sertifikalarım</span>
        </a>
        <a href="#" class="sidebar-link placeholder-link" data-module="Çalışma Yaklaşımım">
            <i class="bi bi-diagram-3"></i>
            <span>Çalışma Yaklaşımım</span>
        </a>

        <!-- İLETİŞİM -->
        <div class="nav-group-title">İletişim</div>
        <a href="/Admin/Contact/UpdateContact" class="sidebar-link @Active("Contact")">
            <i class="bi bi-telephone"></i>
            <span>İletişim</span>
        </a>
        <a href="/Admin/Message/MessageList" class="sidebar-link @Active("Message")">
            <i class="bi bi-envelope"></i>
            <span>Gelen Mesajlar</span>
        </a>

        <!-- SİSTEM -->
        <div class="nav-group-title">Sistem</div>
        <a href="#" class="sidebar-link placeholder-link" data-module="Site Ayarları">
            <i class="bi bi-gear"></i>
            <span>Site Ayarları</span>
        </a>
        <a href="#" class="sidebar-link placeholder-link" data-module="Profilim">
            <i class="bi bi-person-circle"></i>
            <span>Profilim</span>
        </a>
        <a href="#" class="sidebar-link placeholder-link" data-module="Çıkış Yap">
            <i class="bi bi-box-arrow-right"></i>
            <span>Çıkış Yap</span>
        </a>
    </div>

    <!-- Sidebar Bottom Promo Card -->
    <div class="sidebar-footer-box">
        <div class="d-flex align-items-center gap-2 mb-1">
            <i class="bi bi-stars text-warning fs-6"></i>
            <span class="text-white fw-bold" style="font-size: 0.78rem;">Portfolyonu Güncel Tut</span>
        </div>
        <p class="mb-0 text-white-50" style="font-size: 0.7rem; line-height: 1.35;">
            İçeriklerini düzenleyerek profesyonel profilini her zaman güncel tut.
        </p>
    </div>

    <!-- Version tag -->
    <div class="px-3 pb-3 text-center">
        <span style="font-size: 0.68rem; color: rgba(220, 226, 245, 0.4);">Portfolio CMS v1.0 • ASP.NET Core Ready</span>
    </div>
</aside>
