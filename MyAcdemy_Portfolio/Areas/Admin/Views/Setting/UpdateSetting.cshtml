@model MyAcdemy_Portfolio.Entities.Setting
@{
    ViewData["Title"] = "Ayarlar";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var tr = new System.Globalization.CultureInfo("tr-TR");
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="form-card">
            <form asp-area="Admin" asp-controller="Setting" asp-action="UpdateSetting" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="SettingID" />
                <input type="hidden" asp-for="CvFilePath" />
                <input type="hidden" asp-for="CvUpdatedDate" />

                <div class="form-card-header">
                    <div class="form-card-icon"><i class="bi bi-gear"></i></div>
                    <div>
                        <h5 class="mb-0 fw-bold">Site Ayarları</h5>
                        <small class="text-secondary">Sekme başlığı, arama motoru açıklaması ve CV dosyası.</small>
                    </div>
                </div>

                <div class="form-card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="row g-4">
                        <div class="col-12">
                            <label asp-for="SiteTitle" class="form-label">Site Başlığı <span class="req">*</span></label>
                            <div class="input-icon-wrap">
                                <i class="bi bi-window"></i>
                                <input asp-for="SiteTitle" class="form-control" placeholder="Örn: Özgür Nuri VURAL | Portfolyo" />
                            </div>
                            <span asp-validation-for="SiteTitle"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="MetaDescription" class="form-label">Site Açıklaması (meta description)</label>
                            <textarea asp-for="MetaDescription" class="form-control" rows="2" maxlength="160"></textarea>
                            <span asp-validation-for="MetaDescription"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label" for="cvFile">CV Dosyası (yalnızca PDF, en fazla 5 MB)</label>
                            <input type="file" name="cvFile" id="cvFile" class="form-control" accept=".pdf,application/pdf" />
                            <span class="field-validation-error">@Html.ValidationMessage("cvFile")</span>
                            <small class="text-secondary d-block mt-1">Yeni dosya yüklerseniz eskisi otomatik silinir. Dosya seçmezseniz mevcut CV korunur.</small>
                        </div>
                    </div>
                </div>

                <div class="form-card-footer">
                    <a href="/Admin/Dashboard/Index" class="btn btn-soft"><i class="bi bi-arrow-left me-1"></i> Vazgeç</a>
                    <button type="submit" class="btn btn-accent"><i class="bi bi-check2-circle me-1"></i> Kaydet</button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="form-card">
            <div class="form-card-header">
                <div class="form-card-icon"><i class="bi bi-file-earmark-pdf"></i></div>
                <div>
                    <h5 class="mb-0 fw-bold">Mevcut CV</h5>
                    <small class="text-secondary">Sitedeki "CV İndir" butonu bu dosyayı indirir.</small>
                </div>
            </div>
            <div class="form-card-body">
                @if (!string.IsNullOrEmpty(Model.CvFilePath))
                {
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <i class="bi bi-file-earmark-pdf-fill text-danger" style="font-size:2.4rem;"></i>
                        <div>
                            <div class="fw-semibold">CV yüklü</div>
                            <small class="text-secondary">Son güncelleme: @Model.CvUpdatedDate?.ToString("dd MMMM yyyy HH:mm", tr)</small>
                        </div>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="/Default/DownloadCv" class="btn btn-soft"><i class="bi bi-download me-1"></i> İndir / Test Et</a>
                        <form method="post" action="/Admin/Setting/DeleteCv" class="js-delete-form m-0" data-name="Yüklü CV dosyası">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger" style="border-radius:12px;"><i class="bi bi-trash3 me-1"></i> CV'yi Kaldır</button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="empty-state py-4">
                        <i class="bi bi-file-earmark-arrow-up"></i>
                        Henüz CV yüklenmedi. Sitedeki "CV İndir" butonu gizli kalır.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('cvFile').addEventListener('change', function () {
            const f = this.files[0];
            if (!f) return;
            const isPdf = f.name.toLowerCase().endsWith('.pdf') && f.type === 'application/pdf';
            if (!isPdf || f.size > 5 * 1024 * 1024) {
                Swal.fire({ icon: 'warning', title: 'Geçersiz dosya', text: 'Sadece 5 MB\'a kadar PDF yükleyebilirsiniz.', confirmButtonColor: '#8276D9' });
                this.value = '';
            }
        });
    </script>
}
